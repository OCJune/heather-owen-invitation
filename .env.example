# 노션 내부 연결(Internal connection) 토큰 — app.notion.com/developers
NOTION_TOKEN=

# 노션 DB의 데이터 소스 ID (DB 설정 → Manage data sources → Copy data source ID)
NOTION_PHOTOS_DATA_SOURCE_ID=
NOTION_ACCOUNTS_DATA_SOURCE_ID=
NOTION_GUESTBOOK_DATA_SOURCE_ID=
NOTION_RSVP_DATA_SOURCE_ID=

# 노션 웹훅을 등록할 때 받은 verification_token (배포 환경에서만 필요)
NOTION_WEBHOOK_SECRET=

# Cloudinary — 대시보드의 API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
